{
  "name": "phantom-circuit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/main.ts --pretty-logs",
    "debug": "tsx watch --clear-screen=false --inspect=127.0.0.1:9229 src/server/main.ts --pretty-logs --log-level=debug",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src tests scripts *.json *.md",
    "skills:install": "tsx scripts/install-skills.ts",
    "probe": "tsx scripts/probe.ts",
    "test:browser": "tsx scripts/browser-check.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
